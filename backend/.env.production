# ============================================
# CONFIGURACIÓN DEL SERVIDOR - PRODUCCIÓN
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# CONFIGURACIÓN DE LA BASE DE DATOS - PRODUCCIÓN
# ============================================
# ⚠️ IMPORTANTE: Usar variables de entorno en Vercel
# No commitear credenciales reales aquí
DB_TYPE=mysql
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}
DB_DATABASE=${DB_DATABASE}
DB_SYNCHRONIZE=false
DB_AUTO_LOAD_ENTITIES=true

# ============================================
# CONFIGURACIÓN DE CORS - PRODUCCIÓN
# ============================================
CORS_ORIGIN=https://jotamatera.coriadev.com
